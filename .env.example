# Copy this file to .env and edit locally.
# Never put a real token in this file or commit .env.

# Optional. Fine-grained, read-only GitHub token (Phase 2+).
# Leave empty to use unauthenticated public API only.
GITHUB_TOKEN=

# Public GitHub username to import (no private data without a token).
GITHUB_USERNAME=vaibhav007-star

# Local-only SQLite. Relative paths are resolved from the project root.
DATABASE_URL=sqlite:///data/career.db

# Bind only to loopback. Do not change to 0.0.0.0.
APP_BIND_HOST=127.0.0.1
APP_PORT=8501

LOG_LEVEL=INFO
MAX_UPLOAD_MB=10
